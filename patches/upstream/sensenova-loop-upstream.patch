+static bool check_sensenova_loop_metadata(const size_t seed, const float stdev) {
+    const std::pair<llm_kv, uint32_t> invalid[] = {
+        { LLM_KV_LOOP_START,           6 },
+        { LLM_KV_LOOP_END,             9 },
+        { LLM_KV_LOOP_COUNT,           0 },
+        { LLM_KV_LOOP_COUNT,           1073741826 }, // wraps the old 32-bit layer count to 12
+        { LLM_KV_PHYSICAL_LAYER_COUNT, 13 },
+        { LLM_KV_MHC_STREAMS,          1 },
+        { LLM_KV_MHC_ITERATIONS,       0 },
+        { LLM_KV_MHC_ITERATIONS,       101 },
+    };
+    for (const auto & test : invalid) {
+        auto gguf_ctx = get_gguf_ctx(LLM_ARCH_SENSENOVA_LOOP, false);
+        kv_writer(LLM_ARCH_SENSENOVA_LOOP, gguf_ctx.get()).add_kv(test.first, test.second);
+        try {
+            get_model(gguf_ctx.get(), nullptr, seed, stdev, {});
+        } catch (const std::runtime_error &) {
+            continue;
+        }
+        LOG_ERR("SenseNova Loop accepted invalid metadata: %s=%u\n", llama_arch_kv_name(LLM_ARCH_SENSENOVA_LOOP, test.first).c_str(), test.second);
+        return false;
+    }
+    for (llm_kv key : { LLM_KV_LOOP_START, LLM_KV_LOOP_END, LLM_KV_LOOP_COUNT,
+                       LLM_KV_PHYSICAL_LAYER_COUNT, LLM_KV_MHC_STREAMS, LLM_KV_MHC_ITERATIONS }) {
+        auto gguf_ctx = get_gguf_ctx(LLM_ARCH_SENSENOVA_LOOP, false);
+        gguf_remove_key(gguf_ctx.get(), llama_arch_kv_name(LLM_ARCH_SENSENOVA_LOOP, key).c_str());
+        try {
+            get_model(gguf_ctx.get(), nullptr, seed, stdev, {});
+        } catch (const std::runtime_error &) {
+            continue;
+        }
+        LOG_ERR("SenseNova Loop accepted missing metadata: %s\n", llama_arch_kv_name(LLM_ARCH_SENSENOVA_LOOP, key).c_str());
+        return false;
+    }
+    for (uint32_t start : { 0u, 4u }) {
+        auto gguf_ctx = get_gguf_ctx(LLM_ARCH_SENSENOVA_LOOP, false);
+        kv_writer ms(LLM_ARCH_SENSENOVA_LOOP, gguf_ctx.get());
+        ms.add_kv(LLM_KV_LOOP_START, start);
+        ms.add_kv(LLM_KV_LOOP_END, start + 4);
+        auto model_and_ctx = get_model_and_ctx(gguf_ctx.get(), nullptr, seed, stdev, {});
+        std::vector<llama_token> tokens = { 1, 2, 3, 4 };
+        if (llama_decode(model_and_ctx.second.get(), llama_batch_get_one(tokens.data(), tokens.size())) != 0) {
+            return false;
+        }
+        const float * logits = llama_get_logits_ith(model_and_ctx.second.get(), -1);
+        const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model_and_ctx.first.get()));
+        for (int32_t i = 0; i < n_vocab; ++i) {
+            if (!std::isfinite(logits[i])) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
